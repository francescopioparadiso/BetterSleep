{
  "serviceInfo": {
    "serviceID": 2,
    "name": "Sleep Cycle Manager",
    "host": "sleep-cycle-manager",
    "port": 9092,
    "internal_endpoint": "http://sleep-cycle-manager:9092",
    "external_endpoint": "http://localhost:9092",
    "type": "Manager"
  },
  "MQTT": {
    "broker": "mqtt-broker",
    "port": 1883,
    "topic_subscribe": [
      "House/+/Bedroom/+/sensor/+/+/data",
      "House/+/Bedroom/+/actuator/+/data",
      "UserService/ChangePreference/#",
      "Catalog/ActuatorAdded/House/+/Bedroom/+",
      "Catalog/ActuatorRemoved/House/+/Bedroom/+"
    ],
    "topic_publish": [
      "House/{houseID}/Bedroom/{bedroomid}/actuator/{device}/command",
      "House/{houseID}/Bedroom/{bedroomid}/heart_rate",
      "BedAnalitics/userid/{userid}/Bedroom/{bedroomid}/FinishSleep",
      "BedAnalitics/userid/{userid}/Bedroom/{bedroomid}/StartSleep",
      "House/{houseid}/Bedroom/{bedroomid}/phase"
    ],
    "clientID": "SleepCycleManagerClientBetterSleep"
  },
  "catalogURL": "http://catalog:8080",
  "removeInterval": 10,
  "transitionWindowMin": 30,
  "transitionCurveExponent": 1.0,
  "sleepDetectionSec": 1800,
  "wakeDetectionSec": 1800,
  "userCacheTTLSec": 7200,
  "evictionIntervalSec": 300,
  "temperatureTolerance": 1.0
}
