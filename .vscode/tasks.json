{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Database",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build postgresUser timeseries-mongo mqtt-broker",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Catalog",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build catalog",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "User Service",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build user-service",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "TimeSeries",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build time-series",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "BedAnalytics",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build bed-analytics",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "SleepCycleManager",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build sleep-cycle-manager",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🚀 Start All Servers",
      "dependsOn": [
        "Database",
        "Catalog",
        "User Service",
        "TimeSeries",
        "BedAnalytics",
        "SleepCycleManager"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🛑 Stop All Servers",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🧹 Clean DB (Previous Test Cycle)",
      "type": "shell",
      "command": "python3 Simulation/clean_db.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "test",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Test Sleep Cycle",
      "type": "shell",
      "command": "python3",
      "args": [
        "Simulation/night_simulation.py",
        "--target-date",
        "${input:nightSimulationDate}",
        "--duration-seconds",
        "20"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SIMULATION_CATALOG_URL": "http://127.0.0.1:8080",
          "SIMULATION_MQTT_BROKER": "127.0.0.1",
          "SIMULATION_MQTT_PORT": "1883",
          "SIMULATION_PUBLIC_HOST": "127.0.0.1",
          "PUBLIC_HOST": "127.0.0.1"
        }
      },
      "presentation": {
        "group": "test",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Backfill Sensor Data",
      "type": "shell",
      "command": "python3 Simulation/sensor_simulation.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SIMULATION_CATALOG_URL": "http://127.0.0.1:8080",
          "SIMULATION_MQTT_BROKER": "127.0.0.1",
          "SIMULATION_MQTT_PORT": "1883",
          "SIMULATION_PUBLIC_HOST": "127.0.0.1",
          "PUBLIC_HOST": "127.0.0.1"
        }
      },
      "presentation": {
        "group": "test",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Simulate Sensors Backfill",
      "type": "shell",
      "command": "python3",
      "args": [
        "simulation/sensor_simulation.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "nightSimulationDate",
      "type": "promptString",
      "description": "Enter the night base date in YYYY-MM-DD format",
      "default": "2026-03-20"
    }
  ]
}
