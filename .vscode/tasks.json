{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Database",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build postgresUser timeseries-mongo mqtt-broker",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Catalog",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build --no-deps catalog",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "User Service",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build --no-deps user-service",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "TimeSeries",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build --no-deps time-series",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "BedAnalytics",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build --no-deps bed-analytics",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "SleepCycleManager",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build --no-deps sleep-cycle-manager",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🚀 Start All Servers",
      "dependsOn": [
        "Database",
        "Catalog",
        "User Service",
        "TimeSeries",
        "BedAnalytics",
        "SleepCycleManager"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "🧹 Clean DB (Previous Test Cycle)",
      "type": "shell",
      "command": "python3 clean_db.py",
      "options": {
        "cwd": "${workspaceFolder}/Simulation",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "group": "test",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Test Sleep Cycle",
      "type": "shell",
      "command": "python3 interactive_night_simulation.py",
      "options": {
        "cwd": "${workspaceFolder}/Simulation",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "group": "test",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean night simulation",
      "type": "shell",
      "command": "python3",
      "args": [
        "clean_night_simulation.py",
        "--target-date",
        "${input:nightSimulationDate}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Simulation",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "group": "test",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Backfill Sensor Data",
      "type": "shell",
      "command": "python3 sensor_simulation.py",
      "options": {
        "cwd": "${workspaceFolder}/Simulation",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "group": "test",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Simulate Sensors Backfill",
      "type": "shell",
      "command": "python3",
      "args": [
        "simulation/sensor_simulation.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "nightSimulationDate",
      "type": "promptString",
      "description": "Enter the night base date in YYYY-MM-DD format",
      "default": "2026-03-20"
    }
  ]
}
