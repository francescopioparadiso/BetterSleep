{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start All Servers",
      "type": "shell",
      "command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up --build postgresUser timeseries-mongo mqtt-broker catalog user-service time-series bed-analytics sleep-cycle-manager",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🧪 Test Sleep Cycle",
      "type": "shell",
      "command": "python3 interactive_night_simulation.py",
      "options": {
        "cwd": "${workspaceFolder}/Simulation",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "group": "test",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🧹 Clean night simulation (mongo)",
      "type": "shell",
      "command": "python3",
      "args": [
        "clean_night_simulation.py",
        "--target-date",
        "${input:nightSimulationDate}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Simulation",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "group": "test",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🧹 Clean database (postgres)",
      "type": "shell",
      "command": "python3 clean_db.py",
      "options": {
        "cwd": "${workspaceFolder}/Simulation",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "group": "test",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "nightSimulationDate",
      "type": "promptString",
      "description": "Enter the night base date in YYYY-MM-DD format",
      "default": "2026-03-20"
    }
  ]
}
